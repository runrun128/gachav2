# docker-compose 用の環境変数ファイル。
# コピーして `.env` として保存してから `docker compose up -d --build` を実行してください。
#   cp .env.docker.example .env

# PostgreSQL接続文字列(Neon/Supabase等の無料枠、またはローカルPostgresを指定)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 必ず長くランダムな値に変更してください(推測されるとセッションが偽造できてしまいます)
JWT_SECRET="change-me-to-a-long-random-string"

# 運営(管理者)になるためのコード。信頼できる人にだけ共有してください。
ADMIN_SIGNUP_CODE="change-this-admin-code"

# このアプリを公開するURL(例: https://oracle.example.com)。
# サーバーがフロントも同じオリジンで配信するため、ユーザーが実際にアクセスするURLを指定します。
WEB_ORIGIN="http://localhost:4000"
