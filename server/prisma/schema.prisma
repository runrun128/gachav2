generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  displayName            String
  money                  Int       @default(1000)
  role                   String    @default("user") // "user" | "admin"
  createdAt              DateTime  @default(now())
  lastAnnouncementReadAt DateTime?

  characters            Character[]
  items                 InventoryItem[]
  announcements         Announcement[]       @relation("AnnouncementAuthor")
  receivedAnnouncements Announcement[]       @relation("AnnouncementRecipient")
  passwordResetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Character {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationality   String
  age           Int
  gender        String
  feature       String
  rarity        String
  secretFeature String?
  specialType   String?
  level         Int      @default(1)
  isExclusive   Boolean  @default(false)
  createdAt     DateTime @default(now())

  grantAnnouncement Announcement?

  @@index([userId])
  @@index([userId, rarity])
}

model InventoryItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey  String
  quantity Int    @default(0)

  @@unique([userId, itemKey])
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  authorId   String
  author     User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  coinAmount Int?
  itemKey    String?
  itemAmount Int?
  createdAt  DateTime @default(now())

  // 未設定なら全員宛の告知、設定されていれば特定ユーザーのみに見える個人宛メッセージ
  recipientUserId String?
  recipient       User?   @relation("AnnouncementRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  // 個人宛メッセージにキャラクターを添えて付与した場合、実際に作成されたCharacterへの参照
  grantedCharacterId String?    @unique
  grantedCharacter   Character? @relation(fields: [grantedCharacterId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([recipientUserId])
}
