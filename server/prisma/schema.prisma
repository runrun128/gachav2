generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  displayName            String
  money                  Int       @default(1000)
  role                   String    @default("user") // "user" | "admin"
  createdAt              DateTime  @default(now())
  lastAnnouncementReadAt DateTime?
  selectedTitle          String?
  battleWins             Int       @default(0)
  raidClears             Int       @default(0)
  lastDailyBonusAt       DateTime?
  dailyBonusStreak       Int       @default(0)

  characters            Character[]
  items                 InventoryItem[]
  announcements         Announcement[]       @relation("AnnouncementAuthor")
  receivedAnnouncements Announcement[]       @relation("AnnouncementRecipient")
  passwordResetTokens   PasswordResetToken[]
  pushSubscriptions     PushSubscription[]
  tradeListings         TradeListing[]
  achievements          UserAchievement[]
}

// 実績カタログ自体はコード側(lib/achievements.ts)で定義し、ここでは解除済みの記録のみ持つ
model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Character {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationality   String
  age           Int
  gender        String
  feature       String
  rarity        String
  secretFeature String?
  specialType   String?
  level         Int      @default(1)
  isExclusive   Boolean  @default(false)
  createdAt     DateTime @default(now())
  // 売却/トレードで手放すと設定される。null=現在の手持ち。生涯実績(総ガチャ回数・最高レアリティ・
  // 履歴)はこのフィールドで絞り込まずに算出するため、手放しても過去の記録は消えない。
  soldAt        DateTime?

  grantAnnouncement Announcement?

  @@index([userId])
  @@index([userId, rarity])
}

model LimitedGacha {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  cost        Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// アイテムガチャの設定(1行だけのシングルトン)。運営パネルからコスト/開催状態を変更できる。
model ItemGachaConfig {
  id     String  @id @default("singleton")
  cost   Int     @default(300)
  active Boolean @default(true)
}

// アイテムガチャの抽選プール。運営がどのアイテムを何倍の重みで出すか管理する。
model ItemGachaEntry {
  id        String   @id @default(cuid())
  itemKey   String   @unique
  weight    Int      @default(10)
  createdAt DateTime @default(now())
}

// 運営が管理画面から追加した独自アイテム。既存のITEM_EFFECTのいずれかを指定して
// 挙動を組み立てる(全く新しい効果ロジックはコード変更なしには追加できない)。
// 標準アイテム(game-core組み込み分)のショップ設定(購入可否/価格/カテゴリー)の上書き。
// 独自アイテム(CustomItem)は自身のフィールドを直接編集すればよいため対象外。
model ItemShopOverride {
  itemKey     String   @id
  purchasable Boolean
  price       Int?
  tier        String
  updatedAt   DateTime @updatedAt
}

model CustomItem {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  emoji       String
  price       Int?
  purchasable Boolean  @default(false)
  tier        String
  description String
  effect      String
  value       Float
  createdAt   DateTime @default(now())
}

// 運営が管理画面から追加した独自の趣味(特徴)。ガチャの特徴抽選プールに追加される。
model CustomFeature {
  id        String   @id @default(cuid())
  label     String   @unique
  hpBonus   Int      @default(0)
  atkBonus  Int      @default(0)
  defBonus  Int      @default(0)
  spdBonus  Int      @default(0)
  luckBonus Int      @default(0)
  createdAt DateTime @default(now())
}

// マーケット出品(非同期の売買)。キャラクターは所有権が移るだけ、アイテムは出品と同時に
// 在庫からエスクロー(即時減算)し、キャンセル時に払い戻す(二重出品による売り越しを防ぐため)。
model TradeListing {
  id           String   @id @default(cuid())
  sellerId     String
  seller       User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind         String // "character" | "item"
  characterId  String?
  itemKey      String?
  itemQuantity Int?
  price        Int
  createdAt    DateTime @default(now())

  @@index([sellerId])
}

model InventoryItem {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey  String
  quantity Int    @default(0)

  @@unique([userId, itemKey])
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  authorId   String
  author     User     @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  coinAmount Int?
  itemKey    String?
  itemAmount Int?
  createdAt  DateTime @default(now())

  // 未設定なら全員宛の告知、設定されていれば特定ユーザーのみに見える個人宛メッセージ
  recipientUserId String?
  recipient       User?   @relation("AnnouncementRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  // 個人宛メッセージにキャラクターを添えて付与した場合、実際に作成されたCharacterへの参照
  grantedCharacterId String?    @unique
  grantedCharacter   Character? @relation(fields: [grantedCharacterId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([recipientUserId])
}
