# server/.env にコピーして使用してください

# PostgreSQL接続文字列(Neon/Supabase等の無料枠、またはローカルPostgresを指定)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
COOKIE_NAME="identity_slot_token"

# 運営(管理者)になるためのコード。新規登録時、または既存アカウントでの昇格時に入力する。
ADMIN_SIGNUP_CODE="change-this-admin-code"
